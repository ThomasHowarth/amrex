# Upwind drift term of HypreMLABecLap::setDriftCoeffs with the hypre backend
# (GMRES preconditioned by BoomerAMG): the solve must give back the phi of
# the right-hand side.
n_cell = 32
max_grid_size = 16
cscalar = -20.0

amrex.fpe_trap_invalid = 1
amrex.fpe_trap_overflow = 1
amrex.fpe_trap_zero = 1

hypre_mlabeclap.hypre_solver = GMRES
hypre_mlabeclap.hypre_preconditioner = BoomerAMG
